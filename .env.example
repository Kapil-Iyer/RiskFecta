# Copy to .env and fill in. Never commit .env.
# RiskFecta V2 uses PostgreSQL hosted via Supabase (managed Postgres).
# Use the Supabase project connection string (URI). Fake placeholder only — no real secrets.
#
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional (Phase 2A FastAPI backend). Comma-separated list of allowed CORS
# origins for the future React frontend. Defaults to the standard local
# React dev-server origins (CRA: 3000, Vite: 5173) if unset. Set explicitly,
# never wildcarded, outside local development.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
